{
  "name": "@saka-labs/near-jsonrpc-client",
  "version": "0.9.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saka-labs/near-jsonrpc.git",
    "directory": "packages/jsonrpc-client"
  },
  "homepage": "https://github.com/saka-labs/near-jsonrpc/tree/master/packages/jsonrpc-client#readme",
  "bugs": "https://github.com/saka-labs/near-jsonrpc/issues",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "example": "tsx src/example.ts",
    "test": "jest"
  },
  "dependencies": {
    "@saka-labs/near-jsonrpc-types": "0.9.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.0.5",
    "ts-jest": "^29.4.0",
    "tsup": "^8.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
